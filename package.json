{
  "name": "browser",
  "version": "1.3.1",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always"
  },
  "repository": "https://github.com/FURSOY/browser",
  "build": {
    "appId": "com.fursoybrowser.fursoy",
    "artifactName": "FURSOY-Browser-Setup-${version}.${ext}",
    "productName": "FURSOY Browser",
    "publish": {
      "provider": "github",
      "owner": "FURSOY",
      "repo": "browser"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [],
  "author": "FURSOY",
  "license": "ISC",
  "description": "FURSOY Browser",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-vite": "^4.0.1",
    "nodemon": "^3.1.10"
  }
}